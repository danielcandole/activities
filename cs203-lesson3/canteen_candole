
// 1. Create a discount function using a closure
function makeDiscount(percent) {
    return price => price - (price * percent / 100);
}


// 2. Create a cart using a closure
function makeCart(owner) {
    // Private items array
    const items = [];

    // Return five functions
    return {
        add(name, price) {
            items.push({ name, price });
        },

        count() {
            return items.length;
        },

        total(discount) {
            const prices = items.map(item =>
                discount ? discount(item.price) : item.price
            );

            return prices.reduce((sum, price) => sum + price, 0);
        },

        cheapestFirst() {
            return items
                .slice()
                .sort((a, b) => a.price - b.price)
                .map(item => item.name);
        },

        under(limit) {
            return items
                .filter(item => item.price < limit)
                .map(item => item.name);
        }
    };
}


// 3. Create Pieck's cart
const pieck = makeCart("Pieck");

pieck.add("Rice", 20);
pieck.add("Adobo", 60);
pieck.add("Lumpia", 25);
pieck.add("Juice", 30);


// 4. Test Pieck's cart
console.log("Pieck count:", pieck.count());
console.log("Pieck total:", pieck.total());
console.log("Pieck total with 10% discount:", pieck.total(makeDiscount(10)));
console.log("Pieck total with 20% discount:", pieck.total(makeDiscount(20)));
console.log("Pieck cheapest first:", JSON.stringify(pieck.cheapestFirst()));
console.log("Pieck under 30:", JSON.stringify(pieck.under(30)));


